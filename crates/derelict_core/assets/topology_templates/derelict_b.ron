// Ported from The Synaptic Sea data/procgen/templates/derelict_b.json
(
    id: "derelict_b",
    description: "Derelict variant B — dock + compartments + sealed forward chamber with a high-value cache. Sealed chamber is reachable but blocked by a biomatter blockage the player must clear.",
    zones: [
        (id: "entry", role_pool: [Dock], count: Fixed(1), position_hint: Lateral, deck: 0, layout: Single, attach_to: ""),
        (id: "corridor_a", role_pool: [Corridor], count: Fixed(1), position_hint: Center, deck: 0, layout: Single, attach_to: "entry"),
        (id: "compartment_a", role_pool: [Cargo, CrewQuarters], count: Range(1, 2), position_hint: Lateral, deck: 0, layout: Clustered, attach_to: "corridor_a"),
        (id: "corridor_b", role_pool: [Corridor], count: Fixed(1), position_hint: Bow, deck: 0, layout: Single, attach_to: "corridor_a"),
        (id: "sealed_chamber", role_pool: [Cargo, Armory], count: Range(1, 2), position_hint: Lateral, deck: 0, layout: Clustered, attach_to: "corridor_b"),
        (id: "destination", role_pool: [Bridge], count: Fixed(1), position_hint: Bow, deck: 0, layout: Single, attach_to: "corridor_b"),
    ],
    connections: [
        (from_zone: "entry", to_zone: "corridor_a", distribution: Adjacent),
        (from_zone: "corridor_a", to_zone: "compartment_a", distribution: Spread),
        (from_zone: "corridor_a", to_zone: "corridor_b", distribution: Adjacent),
        (from_zone: "corridor_b", to_zone: "sealed_chamber", distribution: Spread),
        (from_zone: "corridor_b", to_zone: "destination", distribution: Adjacent),
    ],
    deck_config: (max_decks: 1, vertical_transition_bp: 0),
)

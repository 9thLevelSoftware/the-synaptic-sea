{
  "_comment": "ComfyUI API workflow template for Synaptic Sea tile generation. Placeholder values marked with __PLACEHOLDER__ are filled by comfyui_tile_workflow.py",
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_comment": "positive prompt - filled by workflow builder",
    "inputs": {"text": "__POSITIVE_PROMPT__", "clip": ["4", 1]}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_comment": "negative prompt",
    "inputs": {"text": "__NEGATIVE_PROMPT__", "clip": ["4", 1]}
  },
  "10": {
    "class_type": "ControlNetLoader",
    "inputs": {"control_net_name": "depth_sdxl_model.safetensors"}
  },
  "11": {
    "class_type": "LoadImage",
    "_comment": "depth map - filled by workflow builder",
    "inputs": {"image": "__DEPTH_MAP_FILENAME__"}
  },
  "12": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "control_net": ["10", 0],
      "image": ["11", 0],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 0.9
    }
  },
  "20": {
    "class_type": "LoraLoader",
    "_comment": "LoRA - filled by workflow builder when available",
    "inputs": {
      "lora_name": "__LORA_NAME__",
      "strength_model": 0.7,
      "strength_clip": 0.7,
      "model": ["4", 0],
      "clip": ["4", 1]
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["20", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "_comment": "filename_prefix filled by workflow builder",
    "inputs": {"filename_prefix": "__OUTPUT_PREFIX__", "images": ["8", 0]}
  }
}

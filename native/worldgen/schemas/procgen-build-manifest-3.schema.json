        },
        "gameplay_ir": {
          "const": "gameplay-ir-2"
        },
        "generation_trace": {
          "const": "generation-trace-3"
        },
        "presentation_ir": {
          "const": "presentation-ir-2"
        },
        "procgen_bundle": {
          "const": "procgen-bundle-4"
        },
        "procgen_request": {
          "const": "procgen-request-2"
        },
        "site_ir": {
          "const": "site-ir-2"
        },
        "world_ir": {
          "const": "world-ir-2"
        }
      },
      "required": [
        "adaptive_proposal",
        "gameplay_ir",
        "generation_trace",
        "presentation_ir",
        "procgen_bundle",
        "procgen_request",
        "site_ir",
        "world_ir"
      ],
      "type": "object"
    }
  },
  "oneOf": [
    {

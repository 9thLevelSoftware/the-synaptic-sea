      "required": [
        "target",
        "artifact"
      ]
    },
    {
      "properties": {
        "artifact": {
          "properties": {
            "kind": {
              "const": "wasm"
            },
            "path": {
              "const": "addons/derelict/bin/web/derelict_wasm_bg.wasm"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "CauseOfLoss": {
      "enum": [
        "ReactorBreach",
        "Depressurization",
        "PirateBoarding",
        "Plague",
        "DriveMisjump",
        "Unknown"
      ],
      "type": "string"
    },
    "Cell": {
      "additionalProperties": false,
      "properties": {
        "deck": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "deck",
        "x",
        "y"
      ],
      "type": "object"
    },
    "CellRecord": {
      "additionalProperties": false,
      "description": "One occupied cell.",
      "properties": {
        "cell": {
          "$ref": "#/definitions/Cell"
        },
        "decal": {
          "description": "Cosmetic damage decal id (never affects validation/topology).",
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "module_id": {
          "type": "string"
        },
        "room_id": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "variant": {
          "$ref": "#/definitions/DamageVariant"
        }
      },
      "required": [
        "cell",
        "decal",
        "module_id",
        "room_id",
        "variant"
      ],
      "type": "object"
    },
    "DamageEvent": {
      "additionalProperties": false,
      "properties": {
        "deck": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/definitions/DamageEventKind"
        },
        "origin": {
          "items": true,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "int32",
              "type": "integer"
            },
            {
              "format": "int32",
              "type": "integer"
            }
          ],
          "type": "array"
        },
        "radius": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "deck",
        "kind",
        "origin",
        "radius"
      ],
      "type": "object"
    },
    "DamageEventKind": {
      "enum": [
        "Breach",
        "ScorchZone",
        "StructuralFracture",
        "DebrisField"
      ],
      "type": "string"
    },
    "DamageVariant": {
      "description": "Asset damage variant, resolved at export time against the kit's intact/damaged/breached module variants. Structural role (`module_id`) stays stable; only the rendered asset changes.",
      "enum": [
        "Intact",
        "Damaged",
        "Breached"
      ],
      "type": "string"
    },
    "Deck": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "$ref": "#/definitions/DeckLayer"
        }
      },
      "required": [
        "layer"
      ],
      "type": "object"
    },
    "DeckLayer": {
      "additionalProperties": false,
      "description": "One deck's tile data as flat row-major arrays (index = y * width + x).",
      "properties": {
        "decal": {
          "items": {
            "format": "uint8",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        },
        "floor": {
          "items": {
            "$ref": "#/definitions/FloorTile"
          },
          "type": "array"
        },
        "height": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "room_id": {
          "description": "Room id per tile; NO_ROOM (0) = not part of any room (void/space).",
          "items": {
            "format": "uint16",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array"
        },
        "walls": {
          "items": {
            "$ref": "#/definitions/TileWalls"
          },
          "type": "array"
        },
        "width": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "decal",
        "floor",
        "height",
        "room_id",
        "walls",
        "width"
      ],
      "type": "object"
    },
    "Dir": {
      "enum": [
        "North",
        "South",
        "East",
        "West"
      ],
      "type": "string"
    },
    "Domain": {
      "enum": [
        "world",
        "site",
        "gameplay",
        "presentation"
      ],
      "type": "string"
    },
    "EdgeKind": {
      "oneOf": [
        {
          "enum": [
            "Solid",
            "Door",
            "Locked",
            "Hatch",
            "Breach"
          ],
          "type": "string"
        },
        {
          "description": "Interior of a multi-cell room: no wall, never materialized.",
          "enum": [
            "Open"
          ],
          "type": "string"
        }
      ]
    },
    "EdgeKind2": {
      "enum": [
        "Door",
        "OpenCorridor",
        "VerticalShaft",
        "Breach"
      ],
      "type": "string"
    },
    "EdgeRecord": {
      "additionalProperties": false,
      "description": "One canonical boundary.",
      "properties": {
        "cell": {
          "$ref": "#/definitions/Cell",
          "description": "The cell/direction this edge was first derived from (either side is valid; edge_key is what's canonical)."
        },
        "direction": {
          "$ref": "#/definitions/Dir"
        },
        "edge_key": {
          "type": "string"
        },
        "exterior": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/EdgeKind"
        },
        "module_id": {
          "type": "string"
        },
        "portal": {
          "type": "boolean"
        },
        "position": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "room_ids": {
          "description": "(owning-side room, other-side room); NO_ROOM = exterior/void.",
          "items": true,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "uint16",
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "format": "uint16",
              "minimum": 0.0,
              "type": "integer"
            }
          ],
          "type": "array"
        },
        "source_cells": {
          "items": {
            "$ref": "#/definitions/Cell"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "variant": {
          "$ref": "#/definitions/DamageVariant"
        },
        "wrapper_required": {
          "description": "Whether this edge demands a materialized placement (Open and BREACH holes don't).",
          "type": "boolean"
        },
        "yaw_degrees": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cell",
        "direction",
        "edge_key",
        "exterior",
        "kind",
        "module_id",
        "portal",
        "position",
        "room_ids",
        "source_cells",
        "variant",
        "wrapper_required",
        "yaw_degrees"
      ],
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "Door",
        "Container",
        "Terminal",
        "Furniture",
        "Debris",
        "Body",
        "ItemPile"
      ],
      "type": "string"
    },
    "EntitySpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable within this ship; assigned in deterministic order. Save diffs and co-op mutation replication address entities by this id.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "inventory": {
          "items": {
            "$ref": "#/definitions/ItemStack"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/definitions/EntityKind"
        },
        "locked": {
          "type": "boolean"
        },
        "open": {
          "type": "boolean"
        },
        "pos": {
          "$ref": "#/definitions/GridPos"
        },
        "proto": {
          "description": "Prototype key, maps to a scene/visual on the Godot side (\"bed\", \"locker\", \"helm_console\", \"hull_plate_debris\", ...).",
          "type": "string"
        },
        "rotation": {
          "description": "0..=3, 90-degree steps. For doors: 0 = sits on north edge of pos, 1 = west edge.",
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "inventory",
        "kind",
        "locked",
        "open",
        "pos",
        "proto",
        "rotation",
        "tags"
      ],
      "type": "object"
    },
    "ExportSchemas": {
      "additionalProperties": false,
      "properties": {
        "adaptive_proposal": {
          "const": "adaptive-proposal-1"
        },
        "gameplay_ir": {
          "const": "gameplay-ir-1"
        },
        "generation_trace": {
          "const": "generation-trace-1"
        },
        "presentation_ir": {
          "const": "presentation-ir-1"
        },
        "procgen_bundle": {
          "const": "procgen-bundle-1"
        },
        "procgen_request": {
          "const": "procgen-request-1"
        },
        "site_ir": {
          "const": "site-ir-1"
        },
        "world_ir": {
          "const": "world-ir-1"
        }
      },
      "required": [
        "adaptive_proposal",
        "gameplay_ir",
        "generation_trace",
        "presentation_ir",
        "procgen_bundle",
        "procgen_request",
        "site_ir",
        "world_ir"
      ],
      "type": "object"
    },
    "FireZone": {
      "additionalProperties": false,
      "type": "object"
    },
    "FloorPlacement": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "$ref": "#/definitions/Cell"
        },
        "cell_key": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "module_id": {
          "type": "string"
        },
        "position": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "room_id": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "variant": {
          "$ref": "#/definitions/DamageVariant"
        },
        "yaw_degrees": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cell",
        "cell_key",
        "id",
        "module_id",
        "position",
        "room_id",
        "variant",
        "yaw_degrees"
      ],
      "type": "object"
    },
    "FloorTile": {
      "oneOf": [
        {
          "enum": [
            "Deck",
            "Grated",
            "DamagedDeck"
          ],
          "type": "string"
        },
        {
          "description": "Open space / no floor (outside hull, or a breach hole).",
          "enum": [
            "Void"
          ],
          "type": "string"
        }
      ]
    },
    "GameplayIR": {
      "additionalProperties": false,
      "properties": {
        "legacy_slice": {
          "$ref": "#/definitions/GameplaySlice"
        },
        "schema_version": {
          "const": "gameplay-ir-1"
        }
      },
      "required": [
        "legacy_slice",
        "schema_version"
      ],
      "type": "object"
    },
    "GameplaySlice": {
      "additionalProperties": false,
      "properties": {
        "critical_path": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "document_kind": {
          "type": "string"
        },
        "fire_zones": {
          "items": {
            "$ref": "#/definitions/FireZone"
          },
          "type": "array"
        },
        "goal_room": {
          "type": "string"
        },
        "loot_containers": {
          "items": {
            "$ref": "#/definitions/LootContainer"
          },
          "type": "array"
        },
        "objectives": {
          "items": {
            "$ref": "#/definitions/Objective"
          },
          "type": "array"
        },
        "program_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "start_room": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "critical_path",
        "document_kind",
        "fire_zones",
        "goal_room",
        "loot_containers",
        "objectives",
        "program_id",
        "schema_version",
        "start_room",
        "summary"
      ],
      "type": "object"
    },
    "GenerationMetrics": {
      "additionalProperties": false,
      "properties": {
        "entity_count": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "pipeline_executions": {
          "const": 1
        },
        "room_count": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "schema_version": {
          "const": "generation-metrics-1"
        },
        "stage_timings_micros": {
          "additionalProperties": {
            "format": "uint128",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "object"
        },
        "structural_placement_count": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "entity_count",
        "pipeline_executions",
        "room_count",
        "schema_version",
        "stage_timings_micros",
        "structural_placement_count"
      ],
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "candidate_decisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "failed_constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fallback": {
          "type": [
            "string",
            "null"
          ]
        },
        "repairs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retries": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rng_channels": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "schema_version": {
          "const": "generation-trace-1"
        },
        "stage_timings_micros": {
          "additionalProperties": {
            "format": "uint128",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "object"
        }
      },
      "required": [
        "candidate_decisions",
        "failed_constraints",
        "repairs",
        "retries",
        "rng_channels",
        "schema_version",
        "stage_timings_micros"
      ],
      "type": "object"
    },
    "GridPos": {
      "additionalProperties": false,
      "properties": {
        "deck": {
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "deck",
        "x",
        "y"
      ],
      "type": "object"
    },
    "ItemStack": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "qty": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "qty"
      ],
      "type": "object"
    },
    "LootContainer": {
      "additionalProperties": false,
      "properties": {
        "approach_cell": {
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "loot_table": {
          "type": "string"
        },
        "room_id": {
          "type": "string"
        }
      },
      "required": [
        "approach_cell",
        "id",
        "kind",
        "loot_table",
        "room_id"
      ],
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "approach_cell": {
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "approach_distance_cells": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "cell": {
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "interactable": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "room_id": {
          "type": "string"
        },
        "room_role": {
          "type": "string"
        },
        "semantic": {
          "type": "string"
        },
        "sequence": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "approach_cell",
        "approach_distance_cells",
        "cell",
        "id",
        "interactable",
        "kind",
        "room_id",
        "room_role",
        "semantic",
        "sequence",
        "type"
      ],
      "type": "object"
    },
    "PlayerModel": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "signals": {
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "signals"
      ],
      "type": "object"
    },
    "PortalIntent": {
      "additionalProperties": false,
      "description": "Authored doorway between two rooms sharing a real cardinal cell edge. Created at placement time by the topology stage — never derived post-hoc.",
      "properties": {
        "exterior": {
          "description": "Exterior door (to_room == NO_ROOM): airlock onto space.",
          "type": "boolean"
        },
        "from_cell": {
          "$ref": "#/definitions/Cell"
        },
        "from_room": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/definitions/EdgeKind"
        },
        "to_cell": {
          "$ref": "#/definitions/Cell"
        },
        "to_room": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "exterior",
        "from_cell",
        "from_room",
        "state",
        "to_cell",
        "to_room"
      ],
      "type": "object"
    },
    "PresentationIR": {
      "additionalProperties": false,
      "properties": {
        "approved_bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "kit_id": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "schema_version": {
          "const": "presentation-ir-1"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "approved_bindings",
        "kit_id",
        "locale",
        "schema_version",
        "seed"
      ],
      "type": "object"
    },
    "PresentationRequest": {
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "locale",
        "seed"
      ],
      "type": "object"
    },
    "ProcgenRequest": {
      "additionalProperties": false,
      "properties": {
        "content_manifest_hash": {
          "type": "string"
        },
        "difficulty_id": {
          "type": "string"
        },
        "generator_version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "player_model": {
          "$ref": "#/definitions/PlayerModel"
        },
        "presentation": {
          "$ref": "#/definitions/PresentationRequest"
        },
        "requested_domains": {
          "items": {
            "$ref": "#/definitions/Domain"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        },
        "site": {
          "$ref": "#/definitions/SiteRequest"
        },
        "world_seed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "content_manifest_hash",
        "difficulty_id",
        "generator_version",
        "player_model",
        "presentation",
        "requested_domains",
        "schema_version",
        "site",
        "world_seed"
      ],
      "type": "object"
    },
    "Role": {
      "enum": [
        "Airlock",
        "Dock",
        "Corridor",
        "MainSpine",
        "Hub",
        "Ramp",
        "Elevator",
        "Bridge",
        "Engineering",
        "Reactor",
        "LifeSupport",
        "Maintenance",
        "Cargo",
        "Hangar",
        "Storage",
        "Armory",
        "Security",
        "Medical",
        "CrewQuarters",
        "MessHall",
        "Compartment"
      ],
      "type": "string"
    },
    "RoomEdge": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "b": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/definitions/EdgeKind2"
        }
      },
      "required": [
        "a",
        "b",

{
  "$id": "world-ir-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "CoordinateMarker": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {
          "format": "int32",
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value",
        "x",
        "y"
      ],
      "type": "object"
    },
    "RouteEdge": {
      "additionalProperties": false,
      "properties": {
        "cost_bp": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "cost_bp",
        "from",
        "to"
      ],
      "type": "object"
    }
  },
  "properties": {
    "archetype_id": {
      "type": "string"
    },
    "biome_id": {
      "type": "string"
    },
    "extraction_path": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "hazard_id": {
      "type": "string"
    },
    "landmarks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "markers": {
      "items": {
        "$ref": "#/definitions/CoordinateMarker"
      },
      "type": "array"
    },
    "resource_pressure_bp": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "routes": {
      "items": {
        "$ref": "#/definitions/RouteEdge"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "site_seed": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "world_seed": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "x": {
      "format": "int32",
      "type": "integer"
    },
    "y": {
      "format": "int32",
      "type": "integer"
    }
  },
  "required": [
    "archetype_id",
    "biome_id",
    "extraction_path",
    "hazard_id",
    "landmarks",
    "markers",
    "resource_pressure_bp",
    "routes",
    "schema_version",
    "site_id",
    "site_seed",
    "world_seed",
    "x",
    "y"
  ],
  "title": "world-ir-2",
  "type": "object"
}

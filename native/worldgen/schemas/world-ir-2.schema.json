{
  "$id": "world-ir-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "BiomeField": {
      "additionalProperties": false,
      "properties": {
        "biome_id": {
          "type": "string"
        },
        "intensity_bp": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "marker_id": {
          "type": "string"
        }
      },
      "required": [
        "biome_id",
        "intensity_bp",
        "marker_id"
      ],
      "type": "object"
    },
    "CoordinateMarker": {
      "additionalProperties": false,
      "properties": {
        "archetype_id": {
          "type": "string"
        },
        "marker_id": {
          "type": "string"
        },
        "selected": {
          "type": "boolean"
        },
        "site_id": {
          "type": "string"
        },
        "site_seed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "archetype_id",
        "marker_id",
        "selected",
        "site_id",
        "site_seed",
        "x",
        "y"
      ],
      "type": "object"
    },
    "ExtractionGuarantee": {
      "additionalProperties": false,
      "properties": {
        "extraction_anchor_id": {
          "type": "string"
        },
        "hub_anchor_id": {
          "type": "string"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "selected_marker_id": {
          "type": "string"
        }
      },
      "required": [
        "extraction_anchor_id",
        "hub_anchor_id",
        "path",
        "selected_marker_id"
      ],
      "type": "object"
    },
    "HazardField": {
      "additionalProperties": false,
      "properties": {
        "hazard_id": {
          "type": "string"
        },
        "marker_id": {
          "type": "string"
        },
        "severity_bp": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "hazard_id",
        "marker_id",
        "severity_bp"
      ],
      "type": "object"
    },
    "LandmarkRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "marker_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "marker_id"
      ],
      "type": "object"
    },
    "ResourcePressure": {
      "additionalProperties": false,
      "properties": {
        "marker_id": {
          "type": "string"
        },
        "pressure_bp": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "resource_id": {
          "type": "string"
        }
      },
      "required": [
        "marker_id",
        "pressure_bp",
        "resource_id"
      ],
      "type": "object"
    },
    "RouteEdge": {
      "additionalProperties": false,
      "properties": {
        "cost_bp": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "cost_bp",
        "from",
        "to"
      ],
      "type": "object"
    },
    "WorldAnchor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    }
  },
  "properties": {
    "anchors": {
      "items": {
        "$ref": "#/definitions/WorldAnchor"
      },
      "type": "array"
    },
    "archetype_id": {
      "type": "string"
    },
    "biome_fields": {
      "items": {
        "$ref": "#/definitions/BiomeField"
      },
      "type": "array"
    },
    "extraction": {
      "$ref": "#/definitions/ExtractionGuarantee"
    },
    "hazard_fields": {
      "items": {
        "$ref": "#/definitions/HazardField"
      },
      "type": "array"
    },
    "landmarks": {
      "items": {
        "$ref": "#/definitions/LandmarkRecord"
      },
      "type": "array"
    },
    "markers": {
      "items": {
        "$ref": "#/definitions/CoordinateMarker"
      },
      "type": "array"
    },
    "resource_pressures": {
      "items": {
        "$ref": "#/definitions/ResourcePressure"
      },
      "type": "array"
    },
    "routes": {
      "items": {
        "$ref": "#/definitions/RouteEdge"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "world-ir-2"
    },
    "site_id": {
      "type": "string"
    },
    "site_seed": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "world_seed": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "x": {
      "format": "int32",
      "type": "integer"
    },
    "y": {
      "format": "int32",
      "type": "integer"
    }
  },
  "required": [
    "anchors",
    "archetype_id",
    "biome_fields",
    "extraction",
    "hazard_fields",
    "landmarks",
    "markers",
    "resource_pressures",
    "routes",
    "schema_version",
    "site_id",
    "site_seed",
    "world_seed",
    "x",
    "y"
  ],
  "title": "world-ir-2",
  "type": "object"
}

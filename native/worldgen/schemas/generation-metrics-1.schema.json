{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entity_count": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "pipeline_executions": {
      "const": 1
    },
    "room_count": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "schema_version": {
      "const": "generation-metrics-1"
    },
    "stage_timings_micros": {
      "additionalProperties": {
        "maximum": 3600000000,
        "minimum": 0,
        "type": "integer"
      },
      "maxProperties": 4096,
      "propertyNames": {
        "minLength": 1
      },
      "type": "object"
    },
    "structural_placement_count": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "entity_count",
    "pipeline_executions",
    "room_count",
    "schema_version",
    "stage_timings_micros",
    "structural_placement_count"
  ],
  "title": "generation-metrics-1",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "definitions": {
    "AdaptiveAction": {
      "oneOf": [
        {
          "enum": [
            "no_op"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "select_candidate": {
              "properties": {
                "candidate_id": {
                  "type": "string"
                }
              },
              "required": [
                "candidate_id"
              ],
              "type": "object"
            }
          },
          "required": [
            "select_candidate"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "adjust_encounter": {
              "properties": {
                "encounter_id": {
                  "type": "string"
                },
                "pacing_delta": {
                  "format": "int32",
                  "type": "integer"
                }
              },
              "required": [
                "encounter_id",
                "pacing_delta"
              ],
              "type": "object"
            }
          },
          "required": [
            "adjust_encounter"
          ],
          "type": "object"
        }
      ]
    }
  },
  "properties": {

      "$ref": "#/definitions/AdaptiveAction"
    },
    "confidence_bp": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "rationale_codes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rule_model_version": {
      "type": "string"
    },
    "schema_version": {
      "const": "adaptive-proposal-1"
    },
    "score": {
      "format": "int32",
      "type": "integer"
    }
  },
  "required": [
    "action",
    "confidence_bp",
    "rationale_codes",
    "rule_model_version",
    "schema_version",
    "score"
  ],
  "title": "adaptive-proposal-1",
  "type": "object"
